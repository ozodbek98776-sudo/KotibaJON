# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kotibajon"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:7000

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# Firebase (Push notifications)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# SendGrid (Email)
SENDGRID_API_KEY="your-sendgrid-api-key"
FROM_EMAIL="noreply@kotibajon.uz"

# Eskiz SMS (O'zbekiston)
ESKIZ_EMAIL="your-eskiz-email"
ESKIZ_PASSWORD="your-eskiz-password"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# AWS S3 / MinIO
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_BUCKET_NAME="kotibajon-files"
AWS_REGION="eu-west-1"

# Exchange Rate API
EXCHANGE_RATE_API_KEY="your-exchange-rate-api-key"

# Sentry
SENTRY_DSN="your-sentry-dsn"
