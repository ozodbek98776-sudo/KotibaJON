// KOTIBAJON — Prisma Database Schema v1.0
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Language {
  uz
  ru
  en
}

enum Currency {
  UZS
  USD
  EUR
  RUB
}

enum Plan {
  free
  pro
  premium
  family
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum Priority {
  low
  medium
  high
  urgent
}

enum TransactionType {
  income
  expense
}

enum GoalStatus {
  active
  completed
  paused
  failed
}

enum DateType {
  birthday
  anniversary
  payment
  other
}

enum ReminderStatus {
  pending
  sent
  failed
  snoozed
}

enum CategoryType {
  task
  finance
  goal
}

enum Period {
  monthly
  yearly
}

// ============================================================
// USERS
// ============================================================

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  phone        String?   @unique
  name         String
  avatarUrl    String?
  language     Language  @default(uz)
  currency     Currency  @default(UZS)
  timezone     String    @default("Asia/Tashkent")
  plan         Plan      @default(free)
  passwordHash String?
  googleId     String?   @unique
  telegramId   String?   @unique
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  categories     Category[]
  tasks          Task[]
  reminders      Reminder[]
  transactions   Transaction[]
  budgets        Budget[]
  goals          Goal[]
  importantDates ImportantDate[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id       String       @id @default(uuid())
  userId   String?
  user     User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  color    String       @default("#1A3A5C")
  icon     String?
  type     CategoryType
  isSystem Boolean      @default(false)

  // Relations
  tasks        Task[]
  transactions Transaction[]
  goals        Goal[]
  budgets      Budget[]

  @@map("categories")
}

// ============================================================
// TASKS
// ============================================================

model Task {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Task?      @relation("SubTasks", fields: [parentId], references: [id])
  subtasks    Task[]     @relation("SubTasks")
  title       String     @db.VarChar(255)
  description String?    @db.Text
  status      TaskStatus @default(todo)
  priority    Priority   @default(medium)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  dueDate     DateTime?
  isRecurring Boolean    @default(false)
  recurRule   Json?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  reminders  Reminder[]
  comments   TaskComment[]
  files      TaskFile[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@map("task_comments")
}

model TaskFile {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  @@map("task_files")
}

// ============================================================
// REMINDERS
// ============================================================

model Reminder {
  id          String         @id @default(uuid())
  taskId      String?
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  remindAt    DateTime
  channels    Json           @default("[\"push\"]")
  status      ReminderStatus @default(pending)
  snoozeUntil DateTime?
  ringtone    String?
  retryCount  Int            @default(0)
  createdAt   DateTime       @default(now())

  @@map("reminders")
}

// ============================================================
// FINANCE
// ============================================================

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal         @db.Decimal(15, 2)
  currency    String          @default("UZS")
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id])
  description String?         @db.VarChar(255)
  receiptUrl  String?
  date        DateTime        @default(now()) @db.Date
  isRecurring Boolean         @default(false)
  recurRule   Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("transactions")
}

model Budget {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  amount     Decimal   @db.Decimal(15, 2)
  period     Period    @default(monthly)
  month      Int?
  year       Int
  createdAt  DateTime  @default(now())

  @@unique([userId, categoryId, month, year])
  @@map("budgets")
}

// ============================================================
// GOALS
// ============================================================

model Goal {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String     @db.VarChar(255)
  description  String?    @db.Text
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id])
  targetValue  Decimal    @db.Decimal(15, 2)
  currentValue Decimal    @default(0) @db.Decimal(15, 2)
  unit         String     @default("%")
  deadline     DateTime?  @db.Date
  status       GoalStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  milestones GoalMilestone[]
  tasks      GoalTask[]

  @@map("goals")
}

model GoalMilestone {
  id          String    @id @default(uuid())
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(255)
  isDone      Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@map("goal_milestones")
}

model GoalTask {
  goalId String
  taskId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([goalId, taskId])
  @@map("goal_tasks")
}

// ============================================================
// IMPORTANT DATES
// ============================================================

model ImportantDate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(255)
  personName  String?
  date        DateTime @db.Date
  type        DateType @default(birthday)
  remindDays  Int[]    @default([1, 3, 7])
  notes       String?  @db.Text
  isRecurring Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("important_dates")
}
